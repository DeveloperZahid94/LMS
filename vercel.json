{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist/apps/web/browser",
  "installCommand": "npm install --legacy-peer-deps --include=dev",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "node_modules/.prisma/client/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/due-alerts", "schedule": "0 9 * * *" },
    { "path": "/api/cron/due-reminders", "schedule": "30 9 * * *" },
    { "path": "/api/cron/attendance-rollover", "schedule": "5 0 * * *" }
  ]
}
