{
  "name": "lms-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant SaaS Library & Study Cabin Management platform",
  "engines": {
    "node": "20.x"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "api:dev": "nx serve api",
    "web:dev": "nx serve web",
    "dev": "nx run-many -t serve -p api,web --parallel",
    "build": "nx run-many -t build -p api,web",
    "build:api": "nx build api",
    "build:web": "nx build web",
    "build:shared": "tsc -p libs/shared/tsconfig.lib.json",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "vercel-build": "npm run prisma:generate && nx build api && nx build web"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.1.17",
    "@prisma/client": "^5.8.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express": "^4.18.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "serverless-http": "^3.2.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.1.0",
    "@angular/cli": "^17.1.0",
    "@angular/compiler-cli": "^17.1.0",
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.0.3",
    "@nestjs/testing": "^10.3.0",
    "@nx/angular": "^17.2.8",
    "@nx/nest": "^17.2.8",
    "@nx/node": "^17.2.8",
    "@nx/workspace": "^17.2.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "@types/passport-jwt": "^4.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^9.0.7",
    "autoprefixer": "^10.5.0",
    "daisyui": "^4.12.24",
    "jest": "^29.7.0",
    "nx": "^17.2.8",
    "postcss": "^8.5.15",
    "prisma": "^5.8.0",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.3.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
