# ---- Database ----
# Neon, Supabase, or Vercel Postgres connection string
DATABASE_URL="postgresql://user:password@host:5432/lms?sslmode=require"

# ---- JWT ----
JWT_SECRET="change-me-in-production-use-a-32-char-random-string"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="change-me-too-different-from-above"
JWT_REFRESH_EXPIRES_IN="30d"

# ---- App ----
NODE_ENV="development"
PORT=3000
API_PREFIX="api"
CORS_ORIGIN="http://localhost:4200"

# ---- Razorpay (stub when blank) ----
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ---- WhatsApp (stub when blank) ----
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ---- Cron auth (Vercel cron header) ----
CRON_SECRET="random-cron-trigger-secret"

# ---- Frontend (apps/web) ----
NG_APP_API_URL="http://localhost:3000/api"
