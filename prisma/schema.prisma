// LMS Platform — Multi-tenant SaaS Library & Study Cabin Management
// All business tables include `tenantId` to enforce tenant isolation at the DB layer.
// Queries MUST be scoped by tenantId through the TenantPrismaService (see apps/api).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
  // "native" for local dev; the rhel targets are the query engine for Vercel's
  // serverless runtime (Amazon Linux). Without these the API crashes on Vercel
  // with "Query engine binary for current platform could not be found".
  binaryTargets   = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// PLATFORM-LEVEL (no tenantId — managed by SuperAdmin)
// ============================================================

model Tenant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  email       String
  phone       String?
  status      TenantStatus @default(ACTIVE)
  plan        String   @default("starter") // starter | growth | enterprise
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branches     Branch[]
  users        User[]
  students     Student[]
  seats        Seat[]
  attendance   Attendance[]
  payments     Payment[]
  featureFlags FeatureFlag[]
  plans        StudentPlan[]
  examTargets  ExamTarget[]
  notifications Notification[]
  auditLogs    AuditLog[]
  pgRooms      PgRoom[]
  pgRoomAssignments PgRoomAssignment[]
  tiffinSubscriptions TiffinSubscription[]
  expenses     Expense[]
  setting      TenantSetting?
  emailConfig  EmailConfig?

  @@index([status])
  @@map("tenants")
}

// Per-tenant email integration, configured by SuperAdmin.
model EmailConfig {
  id             String   @id @default(uuid())
  tenantId       String   @unique
  provider       String   @default("NONE") // NONE | BREVO | SENDGRID
  brevoApiKey    String?
  sendgridApiKey String?
  fromEmail      String?
  fromName       String?
  enabled        Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("email_configs")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

// SuperAdmin lives outside any tenant.
model PlatformAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("platform_admins")
}

// ============================================================
// TENANT-SCOPED
// ============================================================

model Branch {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  code        String   // unique per tenant
  address     String?
  city        String?
  state       String?
  pincode     String?
  phone       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       User[]
  students    Student[]
  seats       Seat[]
  attendance  Attendance[]
  payments    Payment[]
  pgRooms     PgRoom[]
  tiffinSubscriptions TiffinSubscription[]
  expenses    Expense[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  branchId     String?
  email        String
  passwordHash String
  fullName     String
  phone        String?
  role         UserRole
  isActive     Boolean  @default(true)
  mustChangePassword Boolean @default(false)
  passwordChangedAt  DateTime?
  lastLoginAt  DateTime?
  // Active single-session token. Set to a fresh value on each login when the
  // tenant disallows multiple sessions; the JWT carries a matching `sid` and
  // any token whose sid != this value is rejected (logging out the old device).
  // Null = no single-session enforcement (tenant allows multiple sessions).
  sessionId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  auditLogs    AuditLog[]
  // History this staff member handled / is attributed to (set from the
  // assignment & expense flows). The far side uses SetNull, so removing a staff
  // member never deletes their past records — it just unlinks them.
  expensesAttributed   Expense[]          @relation("ExpenseStaff")
  seatAssignmentsMade  SeatAssignment[]   @relation("SeatAssignmentStaff")
  pgAssignmentsMade    PgRoomAssignment[] @relation("PgAssignmentStaff")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, branchId])
  @@map("users")
}

enum UserRole {
  CLIENT_ADMIN
  BRANCH_ADMIN
  STAFF
}

model Student {
  id                 String   @id @default(uuid())
  tenantId           String
  branchId           String
  code               String   // unique per tenant, e.g. STU-0001
  fullName           String
  email              String?
  phone              String
  gender             Gender?
  dateOfBirth        DateTime?

  // KYC
  aadhaarNumber      String?  // 12 digits, India national ID
  voterId            String?  // EPIC card number

  // Family / emergency
  fatherName         String?
  motherName         String?
  emergencyContact   String?  // phone of next-of-kin

  // Address (split into permanent vs temporary — India context)
  permanentAddress   String?
  temporaryAddress   String?

  // Academic context
  examTarget         String?  // e.g. UPSC, SSC, Banking, NEET, JEE

  photoUrl           String?
  idProofUrl         String?
  aadhaarFrontUrl    String?
  aadhaarBackUrl     String?
  voterIdUrl         String?
  // Self-service (kiosk) login credentials
  passwordHash       String?
  mustChangePassword Boolean @default(false)
  status             StudentStatus @default(ACTIVE)

  joinedAt           DateTime @default(now())   // registration date
  expiresAt          DateTime?                  // membership/plan expiry
  outstandingBalance Decimal  @default(0) @db.Decimal(10, 2) // unpaid balance from part payments

  qrCode             String   @unique @default(uuid()) // scanned for attendance
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  seatAssignments SeatAssignment[]
  attendance    Attendance[]
  payments      Payment[]
  planEnrollments StudentPlanEnrollment[]
  pgRoomAssignments PgRoomAssignment[]
  tiffinSubscriptions TiffinSubscription[]

  @@unique([tenantId, code])
  @@unique([tenantId, phone])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@map("students")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

model Seat {
  id            String   @id @default(uuid())
  tenantId      String
  branchId      String
  code          String   // e.g. A-12 (cabin/seat number) — unique per branch
  type          SeatType @default(SEAT)
  floor         String?
  zone          String?  // section/zone label
  amenities     String[] // ["AC", "wifi", "locker", "power", "24x7"]
  monthlyRates  Json?    // per-shift INR pricing, e.g. { "MORNING": 800, "AFTERNOON": 800, "FULL_DAY": 1500 }
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  assignments SeatAssignment[]

  @@unique([tenantId, branchId, code])
  @@index([tenantId, branchId])
  @@map("seats")
}

enum SeatType {
  SEAT
  CABIN
  HOT_DESK
}

model SeatAssignment {
  id          String   @id @default(uuid())
  tenantId    String
  seatId      String
  studentId   String
  shift       Shift
  startDate   DateTime
  endDate     DateTime?
  /// TEMPORARY = allocated but <50% paid; CONFIRMED = >=50% paid; ENDED = ended.
  /// TEMPORARY and CONFIRMED both block the (seat, shift) from being re-allocated.
  status      SeatAssignmentStatus @default(TEMPORARY)
  /// Monthly rate snapshot at allocation time. Used for the 50% confirmation
  /// threshold so subsequent rate changes don't shift the bar retroactively.
  monthlyRate Decimal? @db.Decimal(10, 2)
  /// Next installment due date — drives the "overdue" / "due soon" alerts.
  /// Updated whenever staff record a payment from the Payments screen.
  nextDueDate DateTime?
  /// Staff member who handled this allocation (optional). SetNull so deleting a
  /// staff member keeps the allocation record intact.
  assignedById String?
  createdAt   DateTime @default(now())

  seat        Seat     @relation(fields: [seatId], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignedBy  User?    @relation("SeatAssignmentStaff", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([tenantId, nextDueDate])
  @@index([tenantId, seatId, status])
  @@index([tenantId, studentId, status])
  @@index([tenantId, assignedById])
  @@map("seat_assignments")
}

enum SeatAssignmentStatus {
  TEMPORARY
  CONFIRMED
  ENDED
}

enum Shift {
  MORNING
  AFTERNOON
  EVENING
  NIGHT
  FULL_DAY
}

model Attendance {
  id          String   @id @default(uuid())
  tenantId    String
  branchId    String
  studentId   String
  date        DateTime @db.Date
  checkInAt   DateTime
  checkOutAt  DateTime?
  source      AttendanceSource @default(QR)
  notes       String?
  // Self check-in capture (geolocation + selfie data URL)
  checkInLat       Float?
  checkInLng       Float?
  checkInSelfieUrl String?
  checkOutLat       Float?
  checkOutLng       Float?
  checkOutSelfieUrl String?
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([tenantId, date])
  @@index([tenantId, branchId, date])
  @@map("attendance")
}

enum AttendanceSource {
  QR
  MANUAL
  BIOMETRIC
  SELF
}

model StudentPlan {
  id          String   @id @default(uuid())
  tenantId    String
  name        String   // e.g. "Monthly AC Cabin"
  description String?
  price       Decimal  @db.Decimal(10, 2)
  durationDays Int     // 30, 60, 90...
  shift       Shift?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollments StudentPlanEnrollment[]

  @@index([tenantId])
  @@map("student_plans")
}

model ExamTarget {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  isCustom  Boolean  @default(false) // false = seeded default (UPSC, SSC...); true = user-added
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("exam_targets")
}

model StudentPlanEnrollment {
  id          String   @id @default(uuid())
  tenantId    String
  studentId   String
  planId      String
  startDate   DateTime
  endDate     DateTime
  amount      Decimal  @db.Decimal(10, 2)
  status      EnrollmentStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  plan        StudentPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments    Payment[]

  @@index([tenantId, studentId])
  @@index([tenantId, endDate]) // for due-alert cron
  @@map("student_plan_enrollments")
}

enum EnrollmentStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Payment {
  id            String   @id @default(uuid())
  tenantId      String
  branchId      String
  studentId     String
  enrollmentId  String?
  amount        Decimal  @db.Decimal(10, 2)
  discount      Decimal  @default(0) @db.Decimal(10, 2) // concession waived alongside this payment (not income)
  discountReason String?
  currency      String   @default("INR")
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  /// Which service this payment is for — drives per-service (seat/PG/tiffin) dues.
  /// GENERAL = unallocated; reduces the combined balance but no single service's due.
  purpose       PaymentPurpose @default(GENERAL)
  // Razorpay refs (null until gateway flow used)
  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?
  receiptNumber String?
  paidAt        DateTime?
  notes         String?
  // Soft delete — kept for audit; hidden from all UI/totals.
  deletedAt     DateTime?
  deletedReason String?
  deletedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment    StudentPlanEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, studentId, createdAt])
  @@index([tenantId, studentId, purpose])
  @@map("payments")
}

enum PaymentPurpose {
  SEAT
  PG
  TIFFIN
  GENERAL
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  NETBANKING
  RAZORPAY
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ============================================================
// PG ROOMS (paying-guest accommodation alongside library seats)
// ============================================================

model PgRoom {
  id            String     @id @default(uuid())
  tenantId      String
  branchId      String
  roomNumber    String     // unique per branch, e.g. "F-25", "101"
  type          PgRoomType @default(SINGLE)
  bedCount      Int        // 1 for SINGLE, 2 for DOUBLE, 3 for TRIPLE; allow override for custom
  monthlyRate   Decimal    @db.Decimal(10, 2)  // per bed, per month
  floor         String?
  notes         String?
  amenities     String[]   // ["AC", "wifi", "attached-bath", "balcony"]
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  assignments   PgRoomAssignment[]

  @@unique([tenantId, branchId, roomNumber])
  @@index([tenantId, branchId])
  @@map("pg_rooms")
}

enum PgRoomType {
  SINGLE
  DOUBLE
  TRIPLE
}

model PgRoomAssignment {
  id          String   @id @default(uuid())
  tenantId    String
  roomId      String
  studentId   String
  bedNumber   Int      // 1..bedCount
  startDate   DateTime @default(now())
  endDate     DateTime?
  monthlyRate Decimal? @db.Decimal(10, 2) // snapshot of rate at allocation time
  nextDueDate DateTime?                   // mirrors seat-assignments pattern
  status      PgAssignmentStatus @default(ACTIVE)
  notes       String?
  /// Staff member who handled this bed allocation (optional). SetNull on delete.
  assignedById String?
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room        PgRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignedBy  User?    @relation("PgAssignmentStaff", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([tenantId, roomId, status])
  @@index([tenantId, studentId, status])
  @@index([tenantId, nextDueDate])
  @@index([tenantId, assignedById])
  @@map("pg_room_assignments")
}

enum PgAssignmentStatus {
  ACTIVE
  ENDED
}

// ============================================================
// TIFFIN (meal subscription add-on — standalone or alongside cabin/PG)
// ============================================================

model TiffinSubscription {
  id              String   @id @default(uuid())
  tenantId        String
  branchId        String
  studentId       String
  mealType        TiffinMealType @default(VEG)
  mealPlan        TiffinMealPlan @default(BOTH)
  monthlyRate     Decimal  @db.Decimal(10, 2)
  paidAmount      Decimal  @default(0) @db.Decimal(10, 2) // total collected toward this tiffin
  balance         Decimal  @default(0) @db.Decimal(10, 2) // signed: >0 due, <0 advance (tiffin-only)
  startDate       DateTime @default(now())
  endDate         DateTime?
  nextDueDate     DateTime?                   // mirrors seat/PG due-date pattern for alerts
  status          TiffinStatus @default(ACTIVE)
  // Delivery person (free-text — delivery boys aren't app users)
  deliveryAssignee String?
  deliveryPhone    String?
  pausedDays      Int      @default(0)        // cumulative days paused (drives due-date extension)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  pauses      TiffinPause[]

  @@index([tenantId, studentId, status])
  @@index([tenantId, nextDueDate])
  @@index([tenantId, branchId])
  @@map("tiffin_subscriptions")
}

// One row per pause period — open (resumedAt = null) means currently paused.
model TiffinPause {
  id             String   @id @default(uuid())
  tenantId       String
  subscriptionId String
  pausedAt       DateTime
  resumedAt      DateTime?
  days           Int?                          // computed on resume
  reason         String?
  createdAt      DateTime @default(now())

  subscription   TiffinSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId, subscriptionId])
  @@map("tiffin_pauses")
}

enum TiffinMealType {
  VEG
  NONVEG
}

enum TiffinMealPlan {
  LUNCH
  DINNER
  BOTH
}

enum TiffinStatus {
  ACTIVE
  PAUSED
  ENDED
}

// ============================================================
// EXPENSES (operational costs — rent, salary, utilities, supplies…)
// ============================================================

model Expense {
  id          String   @id @default(uuid())
  tenantId    String
  branchId    String?                          // null = tenant-wide expense, not tied to a branch
  category    ExpenseCategory @default(MISC)
  title       String                           // short label e.g. "April shop rent"
  amount      Decimal  @db.Decimal(10, 2)
  expenseDate DateTime @default(now())          // when the cost was incurred
  paymentMethod String?                         // CASH | UPI | NETBANKING | CARD | CHEQUE (free-text for flexibility)
  vendor      String?                          // who was paid (landlord, electricity board, staff name…)
  staffId     String?                          // optional staff this expense is attributed to (e.g. SALARY recipient)
  notes       String?

  // ---- Credit / pay-later ----
  paymentStatus ExpensePaymentStatus @default(PAID)  // PAID = settled in full; UNPAID/PARTIAL = on credit
  paidAmount    Decimal  @db.Decimal(10, 2) @default(0)  // how much has been paid so far (outstanding = amount - paidAmount)
  dueDate       DateTime?                        // when the credit is due to be cleared
  paidDate      DateTime?                        // when the expense was fully settled

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  staff       User?    @relation("ExpenseStaff", fields: [staffId], references: [id], onDelete: SetNull)

  @@index([tenantId, expenseDate])
  @@index([tenantId, category])
  @@index([tenantId, branchId])
  @@index([tenantId, staffId])
  @@index([tenantId, paymentStatus])
  @@map("expenses")
}

enum ExpenseCategory {
  RENT
  SALARY
  ELECTRICITY
  WATER
  INTERNET
  MAINTENANCE
  SUPPLIES
  EQUIPMENT
  MARKETING
  MISC
}

enum ExpensePaymentStatus {
  PAID      // settled in full
  PARTIAL   // partly paid, balance outstanding
  UNPAID    // on credit, nothing paid yet
}

// ============================================================
// TENANT SETTINGS (per-tenant JSON blob: SMS, biometric, security, backup, etc.)
// ============================================================

model TenantSetting {
  id        String   @id @default(uuid())
  tenantId  String   @unique
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

// ============================================================
// FEATURE FLAGS (per-tenant toggles managed by SuperAdmin)
// ============================================================

model FeatureFlag {
  id          String   @id @default(uuid())
  tenantId    String
  key         FeatureKey
  enabled     Boolean  @default(false)
  config      Json?    // optional per-feature settings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("feature_flags")
}

enum FeatureKey {
  QR_ATTENDANCE
  WHATSAPP
  REPORTS
  ANALYTICS
  MULTI_BRANCH
  PAYMENT_GATEWAY
  EXPORTS
  PG_ROOMS
  TIFFIN
  DASHBOARD
  STUDENTS
  SEATS
  ALERTS
  SETTINGS
}

// ============================================================
// NOTIFICATIONS & AUDIT
// ============================================================

model Notification {
  id          String   @id @default(uuid())
  tenantId    String
  type        NotificationType
  channel     NotificationChannel
  recipient   String   // phone, email, or userId
  subject     String?
  body        String
  status      NotificationStatus @default(QUEUED)
  metadata    Json?
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("notifications")
}

enum NotificationType {
  DUE_ALERT
  PAYMENT_RECEIVED
  ATTENDANCE_REMINDER
  PLAN_EXPIRY
  CUSTOM
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
  SMS
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  DELIVERED
  READ
}

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String?  // null for platform-level (SuperAdmin) actions
  userId      String?
  action      String   // CREATE_STUDENT, UPDATE_SEAT, HTTP POST, ...
  entity      String   // students, seats, payments, or the request path
  entityId    String?
  diff        Json?    // before/after snapshot, or request/SQL metadata
  method      String?  // HTTP verb (interceptor-captured)
  path        String?  // request path (interceptor-captured)
  statusCode  Int?     // response status (interceptor-captured)
  durationMs  Int?     // request duration in ms
  actorType   String?  // PLATFORM_ADMIN | USER
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
